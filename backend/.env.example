# Base URL of the anime-sama site used for scraping (trailing slash required).
ANIMESAMA_SITE_URL=https://anime-sama.fr/

# Provider used to auto-detect the current anime-sama domain.
ANIMESAMA_PROVIDER_URL=https://anime-sama.pw/

# Comma separated allowed CORS origins ("*" = allow all, dev only).
ANIMESAMA_CORS_ORIGINS=http://localhost,http://localhost:8000

# Shared secret required in the "X-API-Key" header. Leave empty to disable
# auth (development only). MUST match ANIMESAMA_API_KEY in the Laravel app.
ANIMESAMA_API_KEY=

# Default language preference order for the "best" player resolution.
ANIMESAMA_PREFER_LANGUAGES=VF,VOSTFR

# Outgoing HTTP timeout in seconds.
ANIMESAMA_REQUEST_TIMEOUT=20

# --- Trailers (optional) ---------------------------------------------------
# anime-sama has NO trailer data, so hero background trailers are sourced from
# TMDB (free key: https://www.themoviedb.org/settings/api). Leave empty to
# disable trailers (the /api/trailer endpoint then returns youtube_key: null).
ANIMESAMA_TMDB_API_KEY=
ANIMESAMA_TMDB_LANGUAGE=fr-FR
