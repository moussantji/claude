APP_NAME="Manden Baoubab API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Bamako
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de donnees : SQLite par defaut (le plus simple pour demarrer en local)
DB_CONNECTION=sqlite
# --- PROD LWS (MySQL) : commentez la ligne sqlite ci-dessus et activez ceci ---
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=xxxx_mandenbaoubab
# DB_USERNAME=xxxx_manden
# DB_PASSWORD=mettez-le-vrai-mot-de-passe-cpanel

SESSION_DRIVER=file
SESSION_LIFETIME=120
# --- PROD LWS (cookies Sanctum sur le domaine racine, HTTPS obligatoire) ---
# SESSION_DOMAIN=.mandenbaoubab.com
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Origine du front React (Vite) pour le CORS et Sanctum
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# --- PROD LWS : remplacez les 2 lignes ci-dessus par ---
# APP_URL=https://api.mandenbaoubab.com
# FRONTEND_URL=https://mandenbaoubab.com
# SANCTUM_STATEFUL_DOMAINS=mandenbaoubab.com,api.mandenbaoubab.com
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=error
