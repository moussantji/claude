{
  "expo": {
    "name": "Stream",
    "slug": "manden-stream",
    "scheme": "mandenstream",
    "version": "1.1.0",
    "runtimeVersion": "1.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-av",
      "expo-video"
    ],
    "extra": {
      "apiBase": "https://stream.mandenbaoubab.com/api",
      "eas": {
        "projectId": "887d468f-c4c8-4530-9751-f1a78bc833fc"
      }
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.moussantji.mandenstream"
    },
    "splash": {
      "backgroundColor": "#000000"
    },
    "owner": "moussantji"
  }
}
