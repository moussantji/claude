APP_NAME=Anime-Sama
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (sqlite by default; the file is created by migrate) ---
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log

# --- Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
# SANCTUM_TOKEN_EXPIRATION=   # minutes; empty = never expire

# --- CORS (for a browser SPA calling this API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_SUPPORTS_CREDENTIALS=false

# --- Anime-Sama FastAPI backend ---
ANIME_SAMA_BASE_URL=http://localhost:8001
# Must match ANIMESAMA_API_KEY in the backend .env (leave empty in dev).
ANIME_SAMA_API_KEY=
ANIME_SAMA_TIMEOUT=25
# Response cache TTL in seconds (0 disables caching).
ANIME_SAMA_CACHE_TTL=300
