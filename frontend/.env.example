APP_NAME=Anime-Sama
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database ---
# sqlite by default (the file is created by migrate). For persistent caching of
# the anime-sama API data + player links, MySQL is recommended in production:
#   DB_CONNECTION=mysql
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_DATABASE=anime_sama
#   DB_USERNAME=root
#   DB_PASSWORD=secret
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log

# --- Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
# SANCTUM_TOKEN_EXPIRATION=   # minutes; empty = never expire

# --- CORS (for a browser SPA calling this API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_SUPPORTS_CREDENTIALS=false

# --- Anime-Sama FastAPI backend ---
# Base URL of the Python FastAPI service (see ../backend).
ANIME_SAMA_BASE_URL=http://localhost:8001
# Must match ANIMESAMA_API_KEY in the backend .env (leave empty in dev).
ANIME_SAMA_API_KEY=
ANIME_SAMA_TIMEOUT=25

# --- Persistence / caching in the DB ---
# Persist API responses (incl. episode player/"vid" links) so the site serves
# from the database and only hits anime-sama when data is stale/missing. On
# upstream failure, stale data is served. Set to false to always go live.
ANIME_SAMA_STORE=true
# Serve search from the ingested full-catalogue snapshot (no upstream call)
# once `php artisan anime:ingest` has run. false = always proxy searches live.
ANIME_SAMA_LOCAL_SEARCH=true
# Per-type freshness windows in seconds (defaults shown).
ANIME_SAMA_TTL_SEARCH=21600
ANIME_SAMA_TTL_CATALOGUE=43200
ANIME_SAMA_TTL_CATALOGUES=86400
ANIME_SAMA_TTL_EPISODES=3600
ANIME_SAMA_TTL_NEW_EPISODES=900
ANIME_SAMA_TTL_PLANNING=21600
ANIME_SAMA_TTL_TRAILER=2592000
# Fallback TTL for any other type.
ANIME_SAMA_CACHE_TTL=21600

# Trailers are handled by the backend (TMDB). Configure ANIMESAMA_TMDB_API_KEY
# in ../backend/.env to enable the hero background trailer.

# --- Vidmoly (upload YOUR OWN media) ---
# Used by `php artisan media:upload` to upload files you own to your vidmoly
# account and store the links. Only use with content you created or own.
VIDMOLY_API_KEY=
VIDMOLY_API_BASE=https://api.vidmoly.to
VIDMOLY_EMBED_BASE=https://vidmoly.to
VIDMOLY_TIMEOUT=900


# =========================================================================
# Episode Transfer — TARGET hosting accounts
# =========================================================================
# Used by episodes:transfer, episodes:broadcast, episodes:daily-transfer,
# episodes:consolidate and episodes:auto to re-upload videos to your accounts.
#
# Verify all configured connections with:
#   php artisan episodes:check-connections
#
# Reliable + monetizing hosts (recommended targets):
#   • StreamWish  https://streamwish.com  (Panel → API)
#   • Doodstream  https://doodstream.com  (Dashboard → API)
#   • Streamtape  https://streamtape.com  (Account Settings → API: login + key)
# -------------------------------------------------------------------------

# --- StreamWish / StreamHG (target account, pay-per-view) ---
# XFileSharing host that pays creators. API key from the StreamWish panel.
TRANSFER_STREAMWISH_API_KEY=
TRANSFER_STREAMWISH_API_BASE=https://api.streamwish.com/api
TRANSFER_STREAMWISH_EMBED_BASE=https://streamwish.to
TRANSFER_STREAMWISH_TIMEOUT=900

# --- Doodstream (target account, pay-per-view) ---
TRANSFER_DOODSTREAM_API_KEY=
# API host (note: doodapi.com now redirects to doodapi.co, which drops the ?key=;
# point directly at the live host to avoid a 400).
TRANSFER_DOODSTREAM_API_BASE=https://doodapi.co/api
# Playback/embed domain (Doodstream rotates domains — change if playback breaks).
TRANSFER_DOODSTREAM_EMBED_BASE=https://dood.to

# ---- Per-host daily caps for server-to-server remote upload (episodes:remote) ----
# Max remote-upload requests sent to each host PER DAY. Set to whatever each
# host allows (check your account/API limits). Omit to use --default-limit.
# TRANSFER_DOODSTREAM_DAILY_LIMIT=500
# TRANSFER_STREAMTAPE_DAILY_LIMIT=200
# TRANSFER_STREAMWISH_DAILY_LIMIT=200

# --- Streamtape (target account) — needs BOTH login and key ---
# LOGIN = "API/FTP Username" (NOT your email), KEY = "API/FTP Password"
# Both are in Account Settings → API/FTP Credentials (generate the password there).
TRANSFER_STREAMTAPE_LOGIN=
TRANSFER_STREAMTAPE_API_KEY=
TRANSFER_STREAMTAPE_API_BASE=https://api.streamtape.com


# --- Sendvid (no public upload API — endpoints unverified) ---
TRANSFER_SENDVID_API_KEY=
TRANSFER_SENDVID_API_BASE=https://sendvid.com/api

# --- Sibnet (no API — form-based upload, login/password) ---
TRANSFER_SIBNET_LOGIN=
TRANSFER_SIBNET_PASSWORD=

# --- Myvi (endpoints unverified) ---
TRANSFER_MYVI_LOGIN=
TRANSFER_MYVI_PASSWORD=
TRANSFER_MYVI_API_BASE=https://myvi.tv

# --- Dailymotion (Partner API, OAuth2) ---
TRANSFER_DAILYMOTION_API_KEY=
TRANSFER_DAILYMOTION_API_SECRET=
TRANSFER_DAILYMOTION_USERNAME=
TRANSFER_DAILYMOTION_PASSWORD=


# ---- yt-dlp download engine (episodes:auto) ----
# episodes:auto downloads each video with yt-dlp (handles vidmoly HLS, sibnet,
# uqload, and hundreds of hosts). Install it on the machine that runs the
# transfers:  pip install -U yt-dlp   (and ffmpeg for HLS→mp4).
# Set the path if it is not on PATH (e.g. /usr/local/bin/yt-dlp).
YTDLP_PATH=yt-dlp
YTDLP_TIMEOUT=1800


# =========================================================================
# Torrent → player (torrents:process)
# =========================================================================
# The admin submits a MAGNET / .torrent (or direct download links) via the
# admin panel. The torrent is turned into playable episodes by one of two
# providers, then each episode is put online on the TARGET player host
#
#   • aria2 (100% FREE, default): OUR server downloads the torrent with aria2c,
#     then uploads each video file to the host. Uses server bandwidth/disk.
#   • realdebrid (paid): Real-Debrid downloads it and exposes a direct HTTP link
#     per file; the host fetches each link itself (nothing on our server).
#
# The queue is advanced by:  php artisan torrents:process
# (scheduled every 2 minutes — see routes/console.php)
# -------------------------------------------------------------------------

# Which provider handles magnets/.torrents: aria2 (free) | realdebrid (paid).
TORRENT_PROVIDER=aria2

# Max files handled per torrents:process run (bounds each invocation).
TORRENT_FILES_PER_RUN=10

# Per-host DAILY upload cap. Some players limit how many uploads you may push
# per day; when a host's cap is reached, remaining episodes stay queued and
# resume automatically the next day. This budget is SHARED with episodes:remote
# (same host = same daily counter). Default applies to any host without its own
# TRANSFER_<HOST>_DAILY_LIMIT (see the Episode Transfer section above), e.g.:
#   TRANSFER_DOODSTREAM_DAILY_LIMIT=500
#   TRANSFER_STREAMWISH_DAILY_LIMIT=200
TORRENT_DEFAULT_DAILY_LIMIT=200

# --- aria2 provider (100% free, self-hosted download) ---
# Install aria2:  apt install aria2   |   brew install aria2
# Recommended: run it as an RPC daemon (non-blocking, progress polling):
#   aria2c --enable-rpc --rpc-listen-port=6800 --dir=/path/to/torrents --seed-time=0
# If the RPC daemon is unreachable, the CLI binary is used as a blocking fallback.
ARIA2_RPC_URL=http://localhost:6800/jsonrpc
ARIA2_RPC_SECRET=
ARIA2_BINARY=aria2c
# Where torrents are downloaded (created automatically). Files are deleted
# after each episode is uploaded to the host.
TORRENT_DOWNLOAD_DIR="${APP_STORAGE_PATH}/app/torrents"
# Max seconds for a single blocking CLI download (RPC mode ignores this).
TORRENT_DOWNLOAD_TIMEOUT=3600

# Slice mode (LIMITED-DISK VPS): download only N video files at a time, upload
# them, delete, then fetch the next N. Peak disk usage stays ~N episodes instead
# of the whole torrent — so a 30 GB pack works on a 10 GB disk.
#   0 = off (download the whole torrent at once, default)
#   3 = good value for a ~10 GB disk (needs the aria2 RPC daemon, not CLI)
TORRENT_ARIA2_SLICE=0

# --- Real-Debrid provider (paid; only used when TORRENT_PROVIDER=realdebrid) ---
# Get your private API token at: https://real-debrid.com/apitoken
REALDEBRID_API_TOKEN=
REALDEBRID_API_BASE=https://api.real-debrid.com/rest/1.0
REALDEBRID_TIMEOUT=30
